# Variáveis lidas pelo Docker Compose e pelo Certbot.
# Copia este ficheiro para .env na raiz do projeto.
DOMAIN=downloads.example.com
CERTBOT_EMAIL=admin@example.com
# Usa uma password aleatória longa, sem espaços.
REDIS_PASSWORD=troca-por-uma-password-redis-forte

# Token forte e aleatório para consultar /internal/metrics via Authorization: Bearer.
METRICS_TOKEN=gera-um-token-aleatorio-forte
# Limites do runtime aplicados pela API e pelos workers.
MAX_CONCURRENT_DOWNLOADS=2
MAX_ACTIVE_JOBS_PER_OWNER=3
MAX_PENDING_DOWNLOADS=100
MAX_DOWNLOAD_SIZE=2147483648
DOWNLOAD_TIMEOUT_MS=1800000
CONVERSION_TIMEOUT_MS=600000
