# TubeMateX — configuração do servidor
# Copia este ficheiro para .env e preenche os valores no ambiente de execução.
# Nunca comites .env nem credenciais reais.

NODE_ENV=production
PORT=3000
BASE_URL=https://o-teu-dominio.example
SESSION_SECRET=gera-uma-string-aleatoria-longa-com-pelo-menos-32-caracteres

# Diretório persistente para histórico, sessões e ficheiros temporários.
DATA_DIR=/var/lib/tubematex
DOWNLOAD_DIR=/var/lib/tubematex/downloads
HISTORY_DIR=/var/lib/tubematex/history
SESSION_DB_DIR=/var/lib/tubematex
DATABASE_PATH=/var/lib/tubematex/tubematex.sqlite
# Em Compose, o serviço injeta REDIS_HOST=redis e REDIS_PASSWORD a partir da raiz .env.
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=troca-por-uma-password-redis-forte
BULLMQ_QUEUE_NAME=tubematex-downloads
# O Compose define BULLMQ_ROLE=api no app e BULLMQ_ROLE=worker no worker.
# BULLMQ_ROLE=both

# Capacidade e limites operacionais.
MAX_CONCURRENT_DOWNLOADS=2
# Pesquisa global: ytsearch e scsearch funcionam sem tokens; Vimeo/Twitch são opcionais.
SEARCH_PROVIDERS=ytsearch,scsearch,vimeo,twitch
VIMEO_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_APP_ACCESS_TOKEN=
MAX_DOWNLOAD_SIZE=2147483648
API_RATE_LIMIT=180
DOWNLOAD_RATE_LIMIT=20

# Opcional: restringe CORS a uma origem específica quando o frontend está separado.
# ALLOWED_ORIGIN=https://o-teu-dominio.example

# Opcional: login Google. Se ficar vazio, o downloader continua funcional sem login.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# O callback OAuth deve ser: ${BASE_URL}/auth/google/callback
# No Google Cloud Console, adiciona também a origem autorizada correspondente à BASE_URL.

# Opcional: autenticação local do yt-dlp para conteúdos que o YouTube bloqueia sem sessão.
# Prefere um ficheiro cookies.txt exportado de forma segura; nunca o comites.
# YTDLP_COOKIES_FILE=/var/lib/tubematex/secrets/youtube-cookies.txt
# Alternativa local: nome do browser suportado pelo yt-dlp, por exemplo chrome ou firefox.
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Catálogos oficiais de entretenimento. Sem TMDB, AniList/TVmaze continuam disponíveis para metadata; sem chaves, o VOD reproduzível continua limitado a fontes públicas compatíveis.
# TMDB_API_KEY=
# TMDB_BEARER_TOKEN=
# TMDB_LANGUAGE=pt-PT
# TMDB_REGION=PT
# Descoberta opcional em catálogos oficiais; sem estes tokens o produto mostra apenas fontes públicas configuradas.
# SPOTIFY_ACCESS_TOKEN=
# SPOTIFY_MARKET=PT
# APPLE_MUSIC_DEVELOPER_TOKEN=
# APPLE_MUSIC_STOREFRONT=pt
# URLs TikTok públicos para descoberta editorial controlada, separados por vírgula.
# TIKTOK_DISCOVERY_URLS=https://www.tiktok.com/@exemplo/video/123
