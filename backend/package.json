{
  "name": "youtube-downloader-backend",
  "version": "1.0.0",
  "description": "Backend multi-plataforma do TubeMateX com yt-dlp, SQLite relacional, autenticação Google e histórico persistente",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "vercel-build": "apt-get update && apt-get install -y python3-pip && pip3 install --upgrade yt-dlp"
  },
  "keywords": [
    "youtube",
    "downloader",
    "multi-site",
    "express",
    "yt-dlp"
  ],
  "author": "Borge",
  "license": "MIT",
  "dependencies": {
    "@openanime/youtube-dl-exec": "^3.0.10",
    "bullmq": "^5.81.3",
    "connect-redis": "^9.0.0",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "ffmpeg": "^1.1.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "redis": "^5.12.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/express-session": "^1.18.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
