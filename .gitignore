# Ignorar logs e arquivos temporários
logs/
*.log
*.tmp

# Segredos locais do yt-dlp e cookies de sessão
backend/secrets/
**/*cookies*.txt
*.cookies.txt

# Dependências
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build e caches
dist/
build/
.cache/

# Dados de runtime: nunca versionar bases, sessões, downloads ou históricos
# Nota: isto não remove ficheiros que já estejam rastreados pelo Git.
data/*.sqlite
data/*.sqlite-*
data/*.db
data/*.db-*
backend/data/*.sqlite
backend/data/*.sqlite-*
backend/data/*.db
backend/data/*.db-*
backend/data/downloads/
backend/data/history/
downloads/
Assets/
downloadHistory.json

# Configuração e segredos locais
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Ficheiros SQLite temporários (inclui qualquer diretório de dados)
**/*.sqlite-shm
**/*.sqlite-wal
**/*.sqlite-journal
**/*.db-shm
**/*.db-wal
**/*.db-journal

# IDE e backups
.vscode/
.idea/
*.swp
*.bak

# Certificados reais e desafios ACME
deploy/certbot/conf/*
!deploy/certbot/conf/.gitkeep
deploy/certbot/www/*
!deploy/certbot/www/.gitkeep
