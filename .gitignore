# Ignorar logs e arquivos temporários
logs/
*.log
*.tmp

# Ignorar dependências globais e módulos do Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignorar diretórios de build e cache
dist/
build/
.cache/

# Ignorar pastas específicas
downloads/
Assets/

# Ignorar arquivos sensíveis ou de configuração local
.env
.env.local
.DS_Store
Thumbs.db

# Ignorar arquivos gerados pelo sistema operacional ou IDEs
.vscode/
.idea/
*.swp
*.bak

# Ignorar histórico de navegação local
downloadHistory.json

# Não versionar certificados ou desafios ACME reais
deploy/certbot/conf/*
!deploy/certbot/conf/.gitkeep
deploy/certbot/www/*
!deploy/certbot/www/.gitkeep